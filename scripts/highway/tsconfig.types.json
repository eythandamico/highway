{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "rootDir": "../..",
    "outDir": "../../packages/highway-react/dist/types",
    "paths": {
      "@/*": [
        "../../*"
      ]
    },
    "types": [
      "react",
      "react-dom"
    ],
    "strictNullChecks": false
  },
  "files": [
    "../../packages/highway-react/src/index.ts"
  ]
}
