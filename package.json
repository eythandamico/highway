{
  "name": "highway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev:showcase",
    "build": "npm run check:boundaries && npm run build:packages && npm run build:showcase && npm run build:demo",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --port 5188",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node tests/verify-effects-build.mjs && node tests/local-api.integration.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "storybook": "storybook dev -p 6008 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check:release": "node scripts/check-release.mjs",
    "package": "node scripts/package.mjs",
    "check:design": "node scripts/check-design.mjs && node --test tests/verify-design-foundation.mjs",
    "test:ui": "playwright test --config playwright.design.config.ts",
    "test:invariant": "playwright test --config playwright.invariant.config.ts",
    "check:ui": "npm run typecheck && npm run lint && npm run check:design && npm run build:starter && npm run build-storybook",
    "check:ui:full": "npm run check:ui && npm run test:ui",
    "test:demo": "node --experimental-strip-types --test tests/verify-demo-workspace.mjs",
    "build:packages": "node scripts/highway/build.mjs",
    "pack:packages": "npm run build:packages && node scripts/highway/pack.mjs",
    "test:packages": "node tests/validate-highway-packages.mjs && npm run build --prefix examples/highway-vite && tsc --project tests/package-browser/tsconfig.json && node tests/package-browser/ssr-smoke.mjs && playwright test --config playwright.package.config.ts",
    "check:packages:clean": "node tests/validate-highway-catalog.mjs && node scripts/highway/check-clean-consumer.mjs",
    "dev:starter": "vinext dev --port 5188",
    "build:starter": "vinext build",
    "dev:showcase": "vite --config apps/showcase/vite.config.ts --port 5190",
    "build:showcase": "vite build --config apps/showcase/vite.config.ts",
    "dev:demo": "vite --config examples/yardwork/vite.config.ts --port 5191",
    "build:demo": "vite build --config examples/yardwork/vite.config.ts",
    "check:boundaries": "node tests/verify-independent-app-boundaries.mjs",
    "adopt": "node scripts/highway/adopt.mjs",
    "check:release:metadata": "node scripts/highway/check-release-metadata.mjs",
    "check:adoption": "node tests/check-highway-adoption.mjs",
    "check:release:packages": "npm run check:release:metadata && npm run check:packages:clean && npm run check:adoption && node scripts/highway/release-manifest.mjs",
    "build:mcp": "npm run build:packages && node scripts/highway/build-mcp.mjs",
    "check:mcp": "npm run build:mcp && npm test --prefix packages/highway-mcp",
    "pack:mcp": "npm run check:mcp && node scripts/highway/pack-mcp.mjs",
    "systems:update": "npm run build:packages && node scripts/highway/systems.mjs --write",
    "check:systems": "node scripts/highway/systems.mjs && node scripts/highway/quality-guard.mjs && tsc --project examples/contracts/tsconfig.json",
    "component:new": "node scripts/highway/create-component.mjs",
    "verify": "npm run build:packages && npm run lint && npm run check:boundaries && node tests/validate-highway-catalog.mjs && npm run check:systems && npm run test:systems",
    "verify:full": "npm run verify && npm run check:ui:full && npm run check:release:packages && npm run check:mcp && npm run check:dependencies",
    "test:systems": "node --test tests/highway-systems.test.mjs",
    "check:dependencies": "npm audit --omit=dev --audit-level=high && npm audit --prefix packages/highway-mcp --omit=dev --audit-level=high",
    "onboard": "node scripts/highway/onboard.mjs",
    "check:onboarding": "node --test tests/check-highway-onboarding.mjs",
    "build:plugins": "npm ci --prefix packages/highway-mcp --ignore-scripts --no-audit --no-fund && npm run build:mcp && node scripts/highway/build-plugins.mjs",
    "prebuild:showcase": "npm run build:plugins",
    "predev:showcase": "npm run build:plugins",
    "check:plugins": "npm run build:plugins && node tests/check-highway-plugins.mjs",
    "build:cloudflare:showcase": "npm run build:plugins && vite build --config apps/showcase/vite.cloudflare.config.ts",
    "build:cloudflare:demo": "vite build --config examples/yardwork/vite.cloudflare.config.ts",
    "deploy:showcase": "npm run build:cloudflare:showcase && wrangler deploy --config apps/showcase/dist/server/wrangler.json",
    "deploy:demo": "npm run build:cloudflare:demo && wrangler deploy --config examples/yardwork/dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/css": "^1.3.9",
    "@lezer/highlight": "1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@shadcn/react": "0.3.0",
    "@visx/curve": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/node": "4.2.1",
    "@tailwindcss/oxide": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.23",
    "react-server-dom-webpack": "19.2.8",
    "storybook": "10.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
