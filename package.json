{
  "name": "app-foundation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vinext dev --port 5188",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --port 5188",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node tests/verify-effects-build.mjs && node tests/local-api.integration.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "storybook": "storybook dev -p 6008 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check:release": "node scripts/check-release.mjs",
    "package": "node scripts/package.mjs",
    "check:design": "node scripts/check-design.mjs && node --test tests/verify-design-foundation.mjs",
    "test:ui": "playwright test --config playwright.design.config.ts",
    "check:ui": "npm run typecheck && npm run lint && npm run check:design && npm run build && npm run build-storybook",
    "check:ui:full": "npm run check:ui && npm run test:ui"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@shadcn/react": "0.3.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "storybook": "10.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
