{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-foundation",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-foundation-db",
      "database_id": "293f31a0-b2e9-4b18-a377-9b794028f72b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "app-foundation-files"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "SITE_ORIGIN": "https://app-foundation.winter-lake-b4eb.workers.dev",
    "AUTH_DELIVERY": "email"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "account_id": "2aebaf88ef9bbc427b720771d94a8efc",
  "workers_dev": true
}
